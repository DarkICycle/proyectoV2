
    <h1 class="text-center mt-4">Listado de Artículos</h1>
    <div class="container">
        <% @articles.each do |article| %>
        <div class="row justify-content-md-center">
            <div class="col-8 mt-4">
                <%# 🚨 CAMBIO CLAVE: QUITAMOS bg-white y dejamos que el CSS lo maneje 🚨 %>
                <div class="card text-center shadow mb-5 rounded">

                    <%# QUITAMOS bg-transparent para que el CSS (wheat) se aplique %>
                    <div class="card-header fst-italic">
                    <%if article.user%>
                        Por <%= link_to article.user.username, user_path(article.user) %>
                    <%end%>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title"><%= link_to article.title, articles_path(article), class: "text-success" %></h5>
                        <p class="card-text"><%= truncate(article.description, lenght: 100) %></p>
                        <%= link_to "Ver", article_path(article), class:"btn btn-outline-success" %>
                        <%=  link_to "Editar", edit_article_path(article), class:"btn btn-outline-info" %>
                        <%=  link_to "Eliminar", article_path(article), class:"btn btn-outline-danger", method:"delete", data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro?" } %>
                    </div>

                    <%# QUITAMOS bg-transparent para que el CSS (wheat) se aplique %>
                    <div class="card-footer text-muted">
                        <small>Creado hace <%= time_ago_in_words(article.created_at) %>, Editado hace <%= time_ago_in_words(article.updated_at) %></small>
                    </div>
                </div>
            </div>
        </div>
        <% end %>
    </div>
