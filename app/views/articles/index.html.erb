<h1>Listado de Artículos</h1>

<%# Itera sobre la variable @articles que definimos en el controlador %>
<table>
  <thead>
    <tr>
      <th>Título</th>
      <th>Descripción</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= article.title %></td>
        <td><%= article.description %></td>
        <td><%= link_to 'Show', article %></td>
        <td><%= link_to 'Edit', article %></td>
        <td><%= link_to 'Delete', article_path(article), data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro de borrar este artículo?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>