<div class="container">


    <div class="row justify-content-center ">
        <div class="col-10">
            <%= render 'shared/errors' %>
            <%= form_with(model: @article, class: "shadow p-3 mb-3 bg-info rounded", local: true) do |f| %>
            <div class="form-group row my-3">
                <%= f.label :Titulo, class: "col-2 col-form-label text-light" %>
                <div class="col-10">
                    <%= f.text_field :title, class: "form-control shadow rounded", placeholder: "Título del Artículo" %>
                </div>
            </div>

            <div class="form-group row my-3">
                <%= f.label :Descripción, class: "col-2 col-form-label text-light" %>
                <div class="col-10">
                    <%= f.text_area :description, rows: 5,  class: "form-control shadow rounded", placeholder: "Descripción del Artículo" %>
                </div>
            </div>

            <div class="form-group row justify-content-center my-3">
                <div class="col-10 text-center">
                    <%= f.submit "Guardar Artículo", class: "btn btn-outline-light btn-lg" %>
                </div>
            </div>

            <% end %>
        </div>
        <%= link_to '[Cancelar y volver al listado de artículos]', articles_path, class: "text-info text-center"%>
    </div>
</div>