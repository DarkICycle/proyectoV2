<h1 class="text-center mt-4">Alpha Bloggers</h1>


<h1 class="text-center mt-4">Listado de Artículos</h1>
<div class="container">
    <% @users.each do |user| %>
    <div class="row justify-content-md-center">
        <div class="col-8 mt-4">
            <%# 🚨 CAMBIO CLAVE: QUITAMOS bg-white y dejamos que el CSS lo maneje 🚨 %>
            <div class="card text-center shadow mb-5 rounded">

                <%# QUITAMOS bg-transparent para que el CSS (wheat) se aplique %>
                <div class="card-header fst-italic">
                    <%= link_to user.username, user %>
                </div>

                <div class="card-body">
                    <h5 class="card-title"><%= link_to gravatar_for(user, size: 150), user %></h5>
                    <p class="card-text"><%= pluralize(user.articles.count, "artículo") %></p>
                    <%= link_to "Ver perfil", user, class:"btn btn-outline-success" %>
                    <%=  link_to "Editar perfil", edit_user_path(user), class:"btn btn-outline-info" %>
                </div>

                <%# QUITAMOS bg-transparent para que el CSS (wheat) se aplique %>
                <div class="card-footer text-muted">
                    <small>Unido hace <%= time_ago_in_words(user.created_at) %></small>
                </div>
            </div>
        </div>
    </div>
    <% end %>
</div>