<h1 class="text-center mt-4">Crear una nueva categoria</h1>
<div class="container">


    <div class="row justify-content-center ">
        <div class="col-10">
            <%= render 'shared/errors', obj: @category %>
            <%= form_with(model: @category, class: "shadow p-3 mb-3 bg-info rounded", local: true) do |f| %>
            <div class="form-group row my-3">
                <%= f.label :name, "Nombre de la categoria",  class: "col-2 col-form-label text-light" %>
                <div class="col-10">
                    <%= f.text_field :name, class: "form-control shadow rounded", placeholder: "Ingresa el nombre de la categoria" %>
                </div>
            </div>

            <div class="form-group row justify-content-center my-3">
                <div class="col-10 text-center">
                    <%= f.submit class: "btn btn-outline-light btn-lg" %>
                </div>
            </div>

            <% end %>
        </div>
        <div class="mb-3 text-center">
            <%= link_to '[Cancelar y volver al listado de artículos]', articles_path, class: "text-info text-center"%>
        </div>
    </div>
</div>